# Absher Neuron 2.0 — Environment template
# Author: Abdulaziz AlAmawi
# Copy to .env and adjust for your environment.

# ── Frontend ──────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Absher Neuron"
NEXT_PUBLIC_APP_VERSION="2.0.0"
NEXT_PUBLIC_APP_OWNER="Abdulaziz AlAmawi"
# WebSocket gateway for the live threat stream (FastAPI AI engine).
NEXT_PUBLIC_AI_WS_URL="ws://localhost:8000/ws/stream"

# ── Database (PostgreSQL / Prisma) ────────────────────────
DATABASE_URL="postgresql://neuron:neuron_secret@localhost:5432/absher_neuron?schema=public"

# ── AI Engine ─────────────────────────────────────────────
AI_ENGINE_HOST="0.0.0.0"
AI_ENGINE_PORT="8000"
